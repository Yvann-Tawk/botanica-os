{
  "name": "botanica-os",
  "private": true,
  "version": "0.1.0",
  "description": "Learn Python by exploring a botanical cosmos: an installable web app that runs real Python in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/young-serif": "^5.1.0",
    "monaco-editor": "^0.52.2",
    "pyodide": "^0.27.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
